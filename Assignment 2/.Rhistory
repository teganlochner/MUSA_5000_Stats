# Select bandwidth using AICc
gwr_bandwidth <- bw.gwr(
model_formula,
data = philly_sp,
approach = "AICc",
kernel = "bisquare",
adaptive = TRUE
)
gwr_bandwidth
gwr_model <- gwr.basic(
model_formula,
data = philly_sp,
bw = gwr_bandwidth,
kernel = "bisquare",
adaptive = TRUE,
F123.test = TRUE,
cv = TRUE
)
# Global GWR diagnostics
gwr_model$GW.diagnostic
gwr_results <- st_as_sf(gwr_model$SDF)
names(gwr_results)
ggplot(gwr_results) +
geom_sf(aes(fill = Local_R2), color = NA) +
scale_fill_viridis_c(
name = "Local R-squared",
na.value = "grey80"
) +
labs(
title = "Local R-squared from Geographically Weighted Regression"
) +
theme_minimal()
names(gwr_results)
# Save GWR residuals
philly$GWR_RESID <- gwr_results$residual
# Global Moran's I
moran.test(
philly$GWR_RESID,
queen_weights,
zero.policy = TRUE
)
# Permutation test
set.seed(5080)
gwr_moran <- moran.mc(
philly$GWR_RESID,
queen_weights,
nsim = 999,
zero.policy = TRUE
)
gwr_moran
names(gwr_results)
# Example for one predictor
gwr_results <- gwr_results %>%
mutate(
ratio_PCTBACHMOR =
PCTBACHMOR / PCTBACHMOR_SE
)
gwr_results <- gwr_results %>%
mutate(
ratio_category = case_when(
ratio_PCTBACHMOR < -2 ~ "Below -2",
ratio_PCTBACHMOR < 0  ~ "-2 to 0",
ratio_PCTBACHMOR <= 2 ~ "0 to 2",
ratio_PCTBACHMOR > 2  ~ "Above 2",
TRUE ~ NA_character_
),
ratio_category = factor(
ratio_category,
levels = c(
"Below -2",
"-2 to 0",
"0 to 2",
"Above 2"
)
)
)
ggplot(gwr_results) +
geom_sf(aes(fill = ratio_category), color = NA) +
scale_fill_manual(
values = c(
"Below -2" = "darkred",
"-2 to 0" = "pink",
"0 to 2" = "lightblue",
"Above 2" = "darkblue"
),
na.value = "grey80",
name = "Coefficient / SE"
) +
labs(
title = "Local Coefficient-to-SE Ratio: Bachelor's Degree"
) +
theme_minimal()
gwr_results <- gwr_results %>%
mutate(
ratio_PCTBACHMOR =
PCTBACHMOR / PCTBACHMOR_SE
)
gwr_results <- gwr_results %>%
mutate(
ratio_category = case_when(
ratio_PCTBACHMOR < -2 ~ "Below -2",
ratio_PCTBACHMOR < 0  ~ "-2 to 0",
ratio_PCTBACHMOR <= 2 ~ "0 to 2",
ratio_PCTBACHMOR > 2  ~ "Above 2",
TRUE ~ NA_character_
),
ratio_category = factor(
ratio_category,
levels = c(
"Below -2",
"-2 to 0",
"0 to 2",
"Above 2"
)
)
)
ggplot(gwr_results) +
geom_sf(aes(fill = ratio_category), color = NA) +
scale_fill_manual(
values = c(
"Below -2" = "darkred",
"-2 to 0" = "pink",
"0 to 2" = "lightblue",
"Above 2" = "darkblue"
),
na.value = "grey80",
name = "Coefficient / SE"
) +
labs(
title = "Local Coefficient-to-SE Ratio: Bachelor's Degree"
) +
theme_minimal()
# Save shapefile with residuals
st_write(philly, "RegressionFinal_Results.gpkg", delete_dsn = TRUE)
# Save GWR local coefficients and diagnostics
st_write(gwr_results, "GWR_Results.gpkg", delete_dsn = TRUE)
# Save regression summaries to a text file
sink("Regression_Summaries.txt")
cat("OLS MODEL\n")
print(summary(ols_model))
cat("\nSPATIAL LAG MODEL\n")
print(summary(lag_model))
cat("\nSPATIAL ERROR MODEL\n")
print(summary(error_model))
cat("\nGWR DIAGNOSTICS\n")
print(gwr_model$GW.diagnostic)
sink()
saveRDS(
list(
ols = ols_model,
spatial_lag = lag_model,
spatial_error = error_model,
gwr = gwr_model,
comparison = model_comparison
),
"Philadelphia_Regression_Models.rds"
)
